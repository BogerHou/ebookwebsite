{
  "name": "shujing-books",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --webpack --hostname 0.0.0.0",
    "build": "node scripts/run-next.mjs build --webpack",
    "start": "node scripts/run-next.mjs start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/validate-catalog.mjs && node scripts/validate-book-details.mjs && node scripts/validate-seo.mjs --static-only && node scripts/test-catalog-search.mjs && node scripts/test-site-config.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "geist": "1.7.2",
    "@radix-ui/react-icons": "1.3.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3"
  }
}
