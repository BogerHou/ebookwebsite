SITE_URL=https://ebooknest.store
RESOURCE_ACCESS_MODE=free
# GA4 web stream measurement ID; configure only in Vercel Production.
# Local development and Preview deployments do not load Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional Cloudflare Google tag gateway path; match its zone configuration.
# Disable Cloudflare's automatic tag setup when this app owns initialization.
NEXT_PUBLIC_GOOGLE_TAG_PATH=
# Configure RESOURCE_LINKS_JSON as a server-side Vercel environment variable.
# Do not prefix it with NEXT_PUBLIC_ or commit the private mapping file.
